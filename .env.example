# Google service-account JSON key file (must have GSC + GA4 read access)
SERVICE_ACCOUNT_FILE=service-account.json

# Google Search Console site URL — one of:
#   https://example.com/          (URL-prefix property)
#   sc-domain:example.com         (Domain property)
GSC_SITE_URL=https://example.com/

# GA4 numeric property ID (no "properties/" prefix)
GA4_PROPERTY_ID=123456789

# Analysis window (days back from today, excluding GSC's 3-day lag)
DAYS_BACK=90

# Pages must have at least this many impressions to be included
MIN_IMPRESSIONS=500

# Pages must have a CTR at or below this threshold (0.03 = 3%)
MAX_CTR=0.03

# How many pages to show in the final report (highest impressions first)
TOP_N=25
